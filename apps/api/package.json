  "scripts": {
    "build": "pnpm run build:all",
    "build:all": "pnpm run build:api && pnpm run build:admin",
    "build:api": "nest build user-api",
    "build:admin": "nest build admin-api",
    "dev": "pnpm run dev:api",
    "dev:api": "nest start user-api --watch",
    "dev:admin": "nest start admin-api --watch",
    "dev:all": "pnpm run dev:api & pnpm run dev:admin",
    "start:prod": "pnpm run start:prod:api",
    "start:prod:api": "node dist/apps/user-api/main",
    "start:prod:admin": "node dist/apps/admin-api/main",
    "migration:create": "dotenvx run -- typeorm-ts-node-commonjs migration:create",
    "migration:apply": "dotenvx run -- typeorm-ts-node-commonjs migration:run -d database/datasource.ts",
    "migration:revert": "dotenvx run -- typeorm-ts-node-commonjs migration:revert -d database/datasource.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:e2e": "jest --config ./apps/api/test/jest-e2e.json"
  },
  "dependencies": {
    "@app/redis-keys": "workspace:*",
    "@app/socket-events": "workspace:*",
